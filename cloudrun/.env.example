# Cloud Hosting environment variables. Do not place real secrets in this file.
PORT=8080
TCB_ENV=your-cloudbase-environment-id
HAIGOO_API_ORIGIN=https://haigooremote.com
MINI_GATEWAY_SHARED_SECRET=replace-with-a-32-byte-random-secret
# Optional development split: read public/formal jobs through a sync-only key
# while all account and interaction writes continue to use HAIGOO_API_ORIGIN.
HAIGOO_JOBS_API_ORIGIN=
MINI_JOBS_GATEWAY_SHARED_SECRET=
MINI_SESSION_SECRET=replace-with-a-different-32-byte-random-secret
# Optional. Development only: Vercel Deployment Protection automation bypass.
VERCEL_AUTOMATION_BYPASS_SECRET=
WECHAT_MINI_APP_ID=wx...
WECHAT_MINI_APP_SECRET=...
# Match apply tickets always point to this configured WeChat business domain.
MINI_WEB_ENTRY_ORIGIN=https://www.haigooremote.com
# Optional: approved WeChat subscription-message template id.
WECHAT_MINI_COMPANY_UPDATE_TEMPLATE_ID=
WECHAT_MINI_PROGRAM_STATE=developer
# Official Mini Program virtual payment. Keep AppKey server-side only.
# Use 1 only for the WeChat sandbox; production must use 0.
WECHAT_VIRTUAL_PAYMENT_OFFER_ID=replace-with-wechat-offer-id
WECHAT_VIRTUAL_PAYMENT_APP_KEY=replace-with-wechat-virtual-payment-app-key
WECHAT_VIRTUAL_PAYMENT_ENV=1
MINI_SYNC_SECRET=replace-with-a-third-random-secret
# Mini Program 1.0 no longer reads job routes. Keep this false to prevent the
# compatibility cache from consuming CloudBase document database calls.
MINI_ENABLE_LEGACY_JOB_CACHE=false
# These settings apply only when the legacy cache is explicitly enabled.
MINI_SYNC_PAGES_PER_RUN=3
MINI_SYNC_WRITE_CONCURRENCY=4
MINI_LOGO_CONCURRENCY=1
MINI_CACHE_REFRESH_MS=3600000
MINI_FULL_SYNC_INTERVAL_MS=86400000
MINI_SYNC_INTERVAL_MS=3600000
MINI_SYNC_LEASE_MS=900000
MINI_LOGO_RETRY_MS=86400000
MINI_LIST_MEMORY_CACHE_MS=300000
MINI_SYNC_STATE_MEMORY_CACHE_MS=60000
MINI_STALE_CLEANUP_MAX_RATIO=0.2
# Reject unusually large or malformed remote logo responses before they can
# exhaust the cloud-hosting Node process. Value is in bytes.
MINI_LOGO_MAX_BYTES=2097152
