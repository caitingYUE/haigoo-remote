# ================================
# 生产环境配置示例
# 这些变量应该在 Vercel Dashboard 中配置
# Environment: Production
# ================================

# 阿里百炼 API 配置（AI Copilot）
VITE_ALIBABA_BAILIAN_API_KEY=your_prod_bailian_api_key

# 会员 CRM 顾问工具（仅配置在 Vercel 服务端，禁止使用 VITE_ 前缀）
ALIBABA_BAILIAN_API_KEY=replace-with-server-only-bailian-key
ALIBABA_BAILIAN_CRM_AGENT_MODEL=qwen-plus
ALIBABA_BAILIAN_CN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# 环境标识
NODE_ENV=production

# 站点配置
SITE_URL=https://haigooremote.com

# Redis 配置（生产环境）
# 从 Upstash 获取生产环境的 Redis URL
REDIS_URL=redis://default:your-prod-redis-password@prod-redis.upstash.io:6379

# Vercel KV 配置（生产环境）
# 从 Vercel Dashboard 获取生产环境的 KV 配置
KV_REST_API_URL=https://your-prod-kv-instance.upstash.io
KV_REST_API_TOKEN=your-prod-kv-token

# JWT 配置（生产环境）
# 使用强密码生成器创建，至少 32 字符
JWT_SECRET=your-very-strong-production-jwt-secret-key-min-32-chars
JWT_EXPIRES_IN=30d

# 微信小程序虚拟支付（仅配置在 Vercel 服务端，禁止使用 VITE_ 前缀）
# planId -> 微信虚拟支付后台已发布的道具 productId；后台价格分别填写 99/499/998 元，
# 支付接口对应传递 9900/49900/99800 分。
WECHAT_MINI_APP_ID=wx...
WECHAT_VIRTUAL_PAYMENT_PRODUCTS_JSON={"club_starter_monthly":"replace-starter-product-id","club_half_year":"replace-member-product-id","club_annual":"replace-partner-product-id"}
# 小程序后台「开发管理 - 消息推送」自行生成的 Token。
# 回调地址：https://haigooremote.com/api/wechat-virtual-payment-notify
WECHAT_MESSAGE_TOKEN=replace-with-a-random-message-token

# PayPal 网站一次性付款（仅配置在 Vercel 服务端，禁止使用 VITE_ 前缀）
# 回调地址：https://haigooremote.com/api/paypal-webhook
# 账户审核、CNY 收款、小额 Live 支付和退款验证完成前必须保持 false。
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=replace-with-live-client-id
PAYPAL_CLIENT_SECRET=replace-with-live-client-secret
PAYPAL_WEBHOOK_ID=replace-with-live-webhook-id
PAYPAL_PAYMENTS_ENABLED=false

# Google OAuth（生产环境）
# 在 Google Cloud Console 创建生产环境的 OAuth 客户端
GOOGLE_CLIENT_ID=your-prod-google-client-id.apps.googleusercontent.com

# Resend 邮件配置（生产环境）
RESEND_API_KEY=re_prod_xxx
FROM_EMAIL=notifications@haigooremote.com
FROM_NAME=Haigoo

# 管理员每日精选岗位邮件（生产环境）
ADMIN_DAILY_DIGEST_EMAIL=hi@haigooremote.com
ADMIN_DAILY_DIGEST_JOB_COUNT=5
ADMIN_DAILY_DIGEST_TIMEZONE=Asia/Shanghai

# 处理后岗位保留天数（生产环境）
# 写入存储前用于最近 N 天过滤，默认 30
PROCESSED_JOBS_RETAIN_DAYS=30

# 网站合规功能开关（资质审核完成前保持 false）
VITE_ENABLE_PERSONALIZED_JOB_DISCOVERY=false
VITE_ENABLE_NON_MEMBER_REFERRAL_ACCESS=false
VITE_ENABLE_MEMBERSHIP_PROMOTION_BANNERS=false
VITE_DISABLE_HOME_CLUB_INFO_CARD=false
VITE_ENABLE_MEMBER_ONLY_JOB_GATING=false
VITE_ENABLE_MEMBER_ONLY_JOB_FILTER=false
VITE_ENABLE_EMPLOYER_RECRUITMENT_INTAKE=false
VITE_DISABLE_CLUB_CONSULTING_ONLY=false
VITE_DISABLE_NON_MEMBER_PROFILE_HOME=false
VITE_ENABLE_PAYPAL_CHECKOUT=false
VITE_ENABLE_HOME_HERO_GREETING_BANNER=false
VITE_ENABLE_HERO_RECOMMENDATIONS_FOR_ALL_USERS=false
VITE_ENABLE_MEMBERSHIP_REDEMPTION=false
VITE_ENABLE_LEGACY_CLUB_STARTER_PARTNER_OFFERS=false
VITE_DISABLE_RETURNING_USER_HERO_RECOMMENDATIONS=false
VITE_HERO_RECOMMENDATION_LEGACY_CUTOFF=2026-08-12T00:00:00+08:00
ENABLE_MEMBER_ONLY_JOB_GATING=false
ENABLE_CUSTOM_FREE_WEBSITE_APPLY_LIMITS=false

# ================================
# 安全注意事项
# ================================
# 1. 所有生产环境变量必须通过 Vercel Dashboard 配置
# 2. 永远不要将生产凭证提交到 Git
# 3. 定期轮换密钥和密码
# 4. 使用强随机密码生成器
# 5. 启用双因素认证保护 Vercel 账户
